{
  "name": "pig-city",
  "productName": "Pig City",
  "version": "1.0.0",
  "description": "A cozy guinea pig town builder.",
  "author": "Lexi Loughlin",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "homepage": "https://lexiloughlin.github.io/pig-city/",
  "scripts": {
    "start": "electron .",
    "audit:sandbox": "node scripts/audit-sandbox.js",
    "pack:dev": "electron-builder --config build/electron-builder.dev.yml --mac dir",
    "dist:dev": "electron-builder --config build/electron-builder.dev.yml --mac",
    "prepare:mas": "node scripts/prepare-mas.js",
    "dist:mas-dev": "node scripts/prepare-mas.js --dev && electron-builder --config build/generated/electron-builder.mas.yml --mac mas-dev",
    "dist:mas": "npm run audit:sandbox && node scripts/prepare-mas.js && electron-builder --config build/generated/electron-builder.mas.yml --mac mas",
    "verify:mas": "node scripts/verify-mas.js",
    "test:tracking": "node scripts/test-gameplay-db.cjs && node scripts/test-network-policy.cjs && node scripts/test-game-bugs.cjs",
    "test:tracking:browser": "electron scripts/test-gameplay-browser.cjs",
    "test:tracking:desktop": "electron scripts/test-gameplay-desktop.cjs",
    "test:simulation": "node scripts/test-simulation.cjs && node scripts/test-city-chunks.cjs && node scripts/test-game-bugs.cjs",
    "test:simulation:browser": "electron scripts/test-simulation-browser.cjs",
    "test:simulation:desktop": "electron scripts/test-simulation-desktop.cjs",
    "test:districts": "node scripts/test-district-identity.cjs && node scripts/test-city-chunks.cjs",
    "test:districts:browser": "electron scripts/test-district-browser.cjs"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  }
}
